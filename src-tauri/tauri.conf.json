{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Invoicer",
  "version": "../package.json",
  "identifier": "com.danifullerton.invoicer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Invoicer",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Local-first invoice app",
    "longDescription": "Create, manage, track, and send professional invoices with client presets, recurring schedules, PDF generation, and email drafting.",
    "createUpdaterArtifacts": true,
    "category": "Business",
    "license": "MIT"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUxQTQ1RDIyMDRERkZBMUUKUldRZSt0OEVJbDJrVWUyMW5UamhzMzlDK2RvMDNxWnZMV01LM2xkcDRGNnVpSWc3Zy8rc0pZVWgK",
      "endpoints": [
        "https://github.com/CheersLoveDani/invoicer/releases/latest/download/latest.json"
      ]
    }
  }
}
